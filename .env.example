# Copy to .env and fill in. Never commit .env.
#
# There are no secrets in here: credentials stay in ~/.aws, managed by the
# AWS CLI (`aws login`). This file only says WHICH profile, region and model.

# The ~/.aws profile to use. boto3 reads AWS_PROFILE and AWS_REGION from the
# environment by itself, so loading this file is all the code needs to do.
AWS_PROFILE=<profile-name>

# Region for every call. The lab uses eu-north-1 (Stockholm).
AWS_REGION=eu-north-1

# The model, as an inference profile ID. "eu." profiles route requests to
# EU regions only. List them with:
#   aws bedrock list-inference-profiles --query 'inferenceProfileSummaries[].inferenceProfileId'
BEDROCK_MODEL=eu.amazon.nova-2-lite-v1:0
